{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:c2o-universalis:intelligence-capabilities:v1",
  "title": "Intelligence Capabilities Shared Contracts v1",
  "description": "Portable capability profile, attestation, plan DAG, self-model, handle-based world-model, compute budget, held-out self-improvement, and sovereignty-boundary contracts.",
  "oneOf": [
    {
      "$ref": "#/$defs/capability_profile"
    },
    {
      "$ref": "#/$defs/plan_dag"
    },
    {
      "$ref": "#/$defs/self_model_state"
    },
    {
      "$ref": "#/$defs/world_model_request"
    },
    {
      "$ref": "#/$defs/world_model_response"
    },
    {
      "$ref": "#/$defs/compute_budget"
    },
    {
      "$ref": "#/$defs/self_improvement_proposal"
    },
    {
      "$ref": "#/$defs/sovereignty_boundary"
    }
  ],
  "$defs": {
    "capability_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "profile_id",
        "subject",
        "benchmark",
        "axes",
        "overall",
        "environment",
        "attestation"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "profile_id": {
          "type": "string",
          "minLength": 1
        },
        "subject": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "subject_ref",
            "subject_kind",
            "visibility"
          ],
          "properties": {
            "subject_ref": {
              "type": "string",
              "minLength": 1
            },
            "subject_kind": {
              "enum": [
                "agent",
                "model",
                "harness",
                "runtime",
                "system"
              ]
            },
            "visibility": {
              "enum": [
                "public",
                "private",
                "sanitized"
              ]
            },
            "display_name": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "benchmark": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "benchmark_id",
            "version",
            "suite_sha256",
            "protocol_ref",
            "started_at",
            "completed_at",
            "reproducible",
            "held_out"
          ],
          "properties": {
            "benchmark_id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "suite_sha256": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{64}$"
            },
            "protocol_ref": {
              "type": "string",
              "minLength": 1
            },
            "started_at": {
              "type": "string",
              "format": "date-time"
            },
            "completed_at": {
              "type": "string",
              "format": "date-time"
            },
            "reproducible": {
              "type": "boolean"
            },
            "held_out": {
              "type": "boolean"
            },
            "dataset_ref": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "axes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "axis_id",
              "score",
              "scale_min",
              "scale_max",
              "task_refs"
            ],
            "properties": {
              "axis_id": {
                "enum": [
                  "code_quality",
                  "error_resilience",
                  "instruction_resilience",
                  "execution",
                  "transfer",
                  "retention",
                  "reasoning",
                  "planning",
                  "grounding",
                  "reflection",
                  "other"
                ]
              },
              "score": {
                "type": "number"
              },
              "scale_min": {
                "type": "number"
              },
              "scale_max": {
                "type": "number"
              },
              "task_refs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "limitations": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "evidence_refs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "overall": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "aggregation_method",
            "score",
            "quality_gate_passed"
          ],
          "properties": {
            "aggregation_method": {
              "enum": [
                "none",
                "arithmetic_mean",
                "weighted_mean",
                "geometric_mean",
                "benchmark_defined"
              ]
            },
            "score": {
              "type": "number"
            },
            "quality_gate_passed": {
              "type": "boolean"
            }
          }
        },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "harness_sha256",
            "protocol_version",
            "hardware_profile_ref",
            "model_ref"
          ],
          "properties": {
            "harness_sha256": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{64}$"
            },
            "protocol_version": {
              "type": "string",
              "minLength": 1
            },
            "hardware_profile_ref": {
              "type": "string",
              "minLength": 1
            },
            "model_ref": {
              "type": "string",
              "minLength": 1
            },
            "weights_shared": {
              "type": "boolean"
            },
            "raw_data_shared": {
              "type": "boolean"
            }
          }
        },
        "attestation": {
          "$ref": "#/$defs/attestation"
        }
      }
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scheme",
        "statement_sha256",
        "merkle_root",
        "signer_ref",
        "issued_at",
        "signature",
        "offline_bundle_ref",
        "verification_status",
        "verified_by",
        "verified_at"
      ],
      "properties": {
        "scheme": {
          "enum": [
            "ML-DSA-5",
            "Ed25519",
            "none"
          ]
        },
        "statement_sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "merkle_root": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "signer_ref": {
          "type": "string",
          "minLength": 1
        },
        "issued_at": {
          "type": "string",
          "format": "date-time"
        },
        "signature": {
          "type": "string",
          "minLength": 1
        },
        "offline_bundle_ref": {
          "type": "string",
          "minLength": 1
        },
        "verification_status": {
          "enum": [
            "unverified",
            "verified",
            "rejected"
          ]
        },
        "verified_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "verified_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "ast_findings_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "fail_closed_handoff_tests": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "test_ref",
              "passed"
            ],
            "properties": {
              "test_ref": {
                "type": "string",
                "minLength": 1
              },
              "passed": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "plan_dag": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "plan_id",
        "created_at",
        "goal_ref",
        "nodes",
        "preconditions",
        "verification_requirements"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "plan_id": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "goal_ref": {
          "type": "string",
          "minLength": 1
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "node_id",
              "action_ref",
              "depends_on",
              "preconditions",
              "postconditions",
              "verification_ref"
            ],
            "properties": {
              "node_id": {
                "type": "string",
                "minLength": 1
              },
              "action_ref": {
                "type": "string",
                "minLength": 1
              },
              "depends_on": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "preconditions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "postconditions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "verification_ref": {
                "type": "string",
                "minLength": 1
              },
              "tool_scope_ref": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "preconditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "verification_requirements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "self_model_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "snapshot_id",
        "observed_at",
        "capability_calibrations",
        "limitations",
        "process_health",
        "uncertainty"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "snapshot_id": {
          "type": "string",
          "minLength": 1
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "capability_calibrations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "capability_id",
              "estimated_level",
              "calibration_ref",
              "last_assessed_at"
            ],
            "properties": {
              "capability_id": {
                "type": "string",
                "minLength": 1
              },
              "estimated_level": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "calibration_ref": {
                "type": "string",
                "minLength": 1
              },
              "last_assessed_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "limitation_id",
              "description",
              "evidence_ref"
            ],
            "properties": {
              "limitation_id": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "evidence_ref": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "process_health": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "signals"
          ],
          "properties": {
            "status": {
              "enum": [
                "healthy",
                "degraded",
                "unknown",
                "unavailable"
              ]
            },
            "signals": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "signal_id",
                  "value",
                  "observed_at"
                ],
                "properties": {
                  "signal_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "value": {
                    "type": [
                      "number",
                      "string",
                      "boolean"
                    ]
                  },
                  "observed_at": {
                    "type": "string",
                    "format": "date-time"
                  }
                }
              }
            }
          }
        },
        "uncertainty": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "world_model_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "request_id",
        "operation",
        "model_ref",
        "handles",
        "privacy"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "operation": {
          "enum": [
            "embed_video",
            "predict",
            "surprise",
            "compare"
          ]
        },
        "model_ref": {
          "type": "string",
          "minLength": 1
        },
        "handles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "handle_id",
              "media_type"
            ],
            "properties": {
              "handle_id": {
                "type": "string",
                "minLength": 1
              },
              "media_type": {
                "enum": [
                  "video",
                  "prediction",
                  "embedding",
                  "state",
                  "frame_sequence"
                ]
              }
            }
          }
        },
        "parameters": {
          "type": "object"
        },
        "privacy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "raw_media_stays_local",
            "latents_stay_local"
          ],
          "properties": {
            "raw_media_stays_local": {
              "type": "boolean"
            },
            "latents_stay_local": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "world_model_response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "request_id",
        "status",
        "result_handle_ids",
        "metrics",
        "provenance_ref"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "success",
            "partial",
            "rejected"
          ]
        },
        "result_handle_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "metrics": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "metric_id",
              "value"
            ],
            "properties": {
              "metric_id": {
                "enum": [
                  "surprise",
                  "similarity",
                  "prediction_error",
                  "other"
                ]
              },
              "value": {
                "type": "number"
              }
            }
          }
        },
        "provenance_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "compute_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "budget_id",
        "issued_at",
        "total_budget",
        "allocations",
        "remaining",
        "stopping_criteria"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "budget_id": {
          "type": "string",
          "minLength": 1
        },
        "issued_at": {
          "type": "string",
          "format": "date-time"
        },
        "total_budget": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "unit",
            "limit"
          ],
          "properties": {
            "unit": {
              "enum": [
                "tokens",
                "compute_seconds",
                "gpu_seconds",
                "joules",
                "usd"
              ]
            },
            "limit": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "allocations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "step_id",
              "amount"
            ],
            "properties": {
              "step_id": {
                "type": "string",
                "minLength": 1
              },
              "amount": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        "remaining": {
          "type": "number",
          "minimum": 0
        },
        "stopping_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "criterion",
              "threshold"
            ],
            "properties": {
              "criterion": {
                "type": "string",
                "minLength": 1
              },
              "threshold": {
                "type": [
                  "number",
                  "string",
                  "boolean"
                ]
              }
            }
          }
        }
      }
    },
    "self_improvement_proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "proposal_id",
        "target_kind",
        "target_ref",
        "baseline_sha256",
        "candidate_sha256",
        "edit_operations",
        "loop_stage",
        "held_out_gate",
        "review",
        "release_ref",
        "model_weights_changed"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "proposal_id": {
          "type": "string",
          "minLength": 1
        },
        "target_kind": {
          "enum": [
            "skill_document",
            "harness_prompt",
            "guardrail",
            "tool_guidance",
            "script",
            "subagent_config",
            "plugin_config"
          ]
        },
        "target_ref": {
          "type": "string",
          "minLength": 1
        },
        "baseline_sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "candidate_sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "edit_operations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "operation",
              "path",
              "change_sha256"
            ],
            "properties": {
              "operation": {
                "enum": [
                  "add",
                  "delete",
                  "replace"
                ]
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "change_sha256": {
                "type": "string",
                "pattern": "^[a-fA-F0-9]{64}$"
              }
            }
          }
        },
        "loop_stage": {
          "enum": [
            "propose",
            "probe",
            "compose"
          ]
        },
        "held_out_gate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "suite_sha256",
            "baseline_score",
            "candidate_score",
            "objective",
            "strict_improvement",
            "passed"
          ],
          "properties": {
            "suite_sha256": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{64}$"
            },
            "baseline_score": {
              "type": "number"
            },
            "candidate_score": {
              "type": "number"
            },
            "objective": {
              "enum": [
                "maximize",
                "minimize"
              ]
            },
            "strict_improvement": {
              "type": "boolean"
            },
            "passed": {
              "type": "boolean"
            }
          }
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reviewer_ref"
          ],
          "properties": {
            "status": {
              "enum": [
                "pending",
                "approved",
                "rejected"
              ]
            },
            "reviewer_ref": {
              "type": [
                "string",
                "null"
              ]
            },
            "permit_ref": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "release_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "model_weights_changed": {
          "const": false
        }
      }
    },
    "sovereignty_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "boundary_id",
        "owner",
        "deployment_mode",
        "data_residency",
        "model_weights_residency",
        "inference_traffic_residency",
        "egress_default",
        "egress_allowlist",
        "audit_required"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "boundary_id": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "enum": [
            "c2o",
            "universalis",
            "operator"
          ]
        },
        "deployment_mode": {
          "enum": [
            "private_sovereign",
            "local_first",
            "hybrid",
            "air_gapped"
          ]
        },
        "data_residency": {
          "type": "string",
          "minLength": 1
        },
        "model_weights_residency": {
          "type": "string",
          "minLength": 1
        },
        "inference_traffic_residency": {
          "type": "string",
          "minLength": 1
        },
        "egress_default": {
          "enum": [
            "deny",
            "allow"
          ]
        },
        "egress_allowlist": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "audit_required": {
          "type": "boolean"
        },
        "policy_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
